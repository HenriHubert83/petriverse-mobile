run = "npm run start:tunnel"
modules = ["nodejs-22", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo mobile"

[[workflows.workflow]]
name = "Expo mobile"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start:tunnel -- --port 8080 --clear"
waitForPort = 8080

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
run = "npm run start:tunnel -- --port 8080"
